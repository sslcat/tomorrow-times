# No keys or network services are needed. All generation is deterministic and offline.
# Opt in with npm run build:showcase and npm run start:showcase for read-only hosting.
SHOWCASE_MODE=false
DATABASE_PATH=./data/tomorrow-times.sqlite
EDITORIAL_TIME_ZONE=America/Chicago
NEXT_PUBLIC_PUBLICATION_NAME=The Tomorrow Times
NEXT_PUBLIC_PUBLICATION_TAGLINE=Tomorrow’s News. A Thousand Years Early.
SITE_URL=http://localhost:3000
# On Vercel, omit SITE_URL to use VERCEL_URL, or set the approved HTTPS origin.
# Run npm run admin:setup to create a unique local secret and enable the editorial desk.
# Development only: the admin desk remains unavailable when NODE_ENV=production.
LOCAL_ADMIN_ENABLED=false
ADMIN_TOKEN=
# Set to the exact private forwarded origin if using Codespaces admin in a browser.
ADMIN_ORIGIN=http://localhost:3000
# Reserved adapters stay inactive. No paid provider is called by this release.
NEWSROOM_MODE=offline
SCHEDULED_NEWSROOM_ENABLED=false
